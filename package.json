{
  "name": "fablab-auftraege",
  "private": true,
  "version": "0.1.0",
  "description": "Auftragsverwaltung FabLab Kiel (opencampus.sh)",
  "type": "module",
  "workspaces": ["shared", "server", "client"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "reset-db": "npm run reset-db -w server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  }
}
